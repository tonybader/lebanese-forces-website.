# Public repository used as the lightweight article store.
CONTENT_REPOSITORY=tonybader/lebanese-forces-website.
CONTENT_BRANCH=main

# The username may remain LFadmin. Set the remaining values only in Vercel.
ADMIN_USERNAME=LFadmin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional dedicated editor login. When omitted, /editor accepts the admin login.
EDITOR_USERNAME=LFeditor
EDITOR_PASSWORD=

GITHUB_CONTENT_TOKEN=

# Optional override for the editor's AI headline/tag analyzer. Vercel deployments
# authenticate to AI Gateway through OIDC automatically.
AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# Contact form security. BLOB_READ_WRITE_TOKEN is added automatically when the
# private Vercel Blob store is connected to the project.
CONTACT_CAPTCHA_SECRET=
BLOB_READ_WRITE_TOKEN=
